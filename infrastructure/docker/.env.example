# SentinelAI production environment. Copy to `.env` (gitignored) and fill in real values.
# NEVER commit the real .env. Prod fails fast if JWT_SECRET/DB_PASSWORD are missing or weak.

# ---- Images ----
# GHCR image base; images are <IMAGE_BASE>-backend / -frontend / -ml.
# For a local trial with locally built images, use: IMAGE_BASE=sentinel-ai  TAG=local
IMAGE_BASE=ghcr.io/OWNER/sentinel-ai
TAG=latest

# ---- Public address / TLS ----
# Caddy: ":80" = plain HTTP (localhost/VM without a domain); a bare domain = automatic HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443
# Used for the API CORS allow-list; set to your real origin in production.
PUBLIC_URL=http://localhost

# ---- Database (required) ----
DB_NAME=sentinelai
DB_USER=sentinel
DB_PASSWORD=change-me-strong-db-password
DB_ROOT_PASSWORD=change-me-strong-root-password

# ---- Auth (required; >=32 chars, not a dev default) ----
JWT_SECRET=change-me-to-a-random-64-char-secret-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- One-time bootstrap admin (applied only on an empty DB) ----
# Used by the deploy smoke test to log in. Must satisfy the password policy (>=12 chars, mixed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@Admin1

# ---- Optional subsystems ----
KAFKA_ENABLED=false
AI_ENABLED=false
AI_PROVIDER=fake
# Only needed when AI_ENABLED=true and AI_PROVIDER=http:
LLM_API_KEY=

# ---- Cloudflare Tunnel (optional; `--profile tunnel`) ----
# Create a tunnel in the Cloudflare dashboard and paste its token here for a free public HTTPS URL.
TUNNEL_TOKEN=
