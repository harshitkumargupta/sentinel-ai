    },
    {
      "type": "timeseries",
      "title": "Detection events/sec & AI latency",
      "datasource": {
        "type": "prometheus",
        "uid": "sentinel-prom"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "sum(rate(sentinel_events_ingested_total[1m]))",
          "legendFormat": "events/s",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sentinel-prom"
          },
          "expr": "rate(sentinel_ai_latency_seconds_sum[5m])/clamp_min(rate(sentinel_ai_latency_seconds_count[5m]),0.001)",
